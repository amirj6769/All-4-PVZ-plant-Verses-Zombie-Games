    ctx.strokeStyle='#455a64'; ctx.lineWidth=2; ctx.beginPath(); ctx.arc(x,y-30,10,Math.PI+0.3,-0.3); ctx.stroke();
  } else if (z.type==='flag') {
    ctx.strokeStyle='#5d4037'; ctx.lineWidth=2; ctx.beginPath(); ctx.moveTo(x+8,y-18); ctx.lineTo(x+8,y-48); ctx.stroke();
    ctx.fillStyle='#c62828'; ctx.beginPath(); ctx.moveTo(x+8,y-48); ctx.lineTo(x+28,y-42); ctx.lineTo(x+8,y-36); ctx.closePath(); ctx.fill();
  }
  let hpR=z.hp/z.maxHp;
  if (hpR<1) { ctx.fillStyle='rgba(0,0,0,0.6)'; ctx.fillRect(x-16,y-44,32,3); ctx.fillStyle=hpR>0.5?'#4caf50':hpR>0.25?'#ff9800':'#f44336'; ctx.fillRect(x-16,y-44,32*hpR,3); }
  if (isSlow&&!z.buttered) { ctx.fillStyle='rgba(100,200,255,0.2)'; ctx.beginPath(); ctx.arc(x,y,22,0,Math.PI*2); ctx.fill(); }
}

function drawBullet(b) {
  let size,color,hl;
  switch(b.type) {
    case 'cabbage': size=8;color='#8bc34a';hl='#aed581'; break;
    case 'melon': size=12;color='#4db6ac';hl='#80cbc4'; break;
    case 'corn': size=5;color='#fff3e0';hl='#ffe0b2'; break;
    case 'butter': size=8;color='#ffd54f';hl='#fff176'; break;
    default: size=6;color='#8bc34a';hl='#aed581';
  }
  let shadowX=lerp(b.sx,b.tx,b.progress), shadowY=b.ty+5;
  ctx.fillStyle='rgba(0,0,0,0.2)'; ctx.beginPath(); ctx.ellipse(shadowX,shadowY,size*0.7,3,0,0,Math.PI*2); ctx.fill();
  if (b.type==='melon') { ctx.fillStyle='rgba(77,182,172,0.2)'; ctx.beginPath(); ctx.arc(b.x,b.y,size+6,0,Math.PI*2); ctx.fill(); }
  if (b.type==='melon') {
    ctx.fillStyle=color; ctx.beginPath(); ctx.ellipse(b.x,b.y,size,size*0.8,0.2,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='#00897b'; ctx.beginPath(); ctx.ellipse(b.x,b.y,size*0.85,size*0.65,0.2,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle='#00695c'; ctx.lineWidth=1;
    for(let i=-1;i<=1;i++){ctx.beginPath();ctx.ellipse(b.x+i*4,b.y,1,size*0.6,0.1,0,Math.PI*2);ctx.stroke();}
    ctx.fillStyle=hl; ctx.globalAlpha=0.3; ctx.beginPath(); ctx.arc(b.x-3,b.y-3,size*0.4,0,Math.PI*2); ctx.fill(); ctx.globalAlpha=1;
  } else if (b.type==='butter') {
    ctx.fillStyle=color; ctx.beginPath(); ctx.ellipse(b.x,b.y,size,size*0.6,Math.sin(b.progress*10)*0.3,0,Math.PI*2); ctx.fill();
    ctx.fillStyle=hl; ctx.globalAlpha=0.5; ctx.beginPath(); ctx.arc(b.x-2,b.y-1,size*0.4,0,Math.PI*2); ctx.fill(); ctx.globalAlpha=1;
  } else {
    ctx.fillStyle=color; ctx.beginPath(); ctx.arc(b.x,b.y,size,0,Math.PI*2); ctx.fill();
    if (b.type==='cabbage') { ctx.fillStyle='#689f38'; ctx.globalAlpha=0.5; ctx.beginPath(); ctx.ellipse(b.x+2,b.y-3,4,2,0.5,0,Math.PI*2); ctx.fill(); ctx.globalAlpha=1; }
    ctx.fillStyle=hl; ctx.globalAlpha=0.5; ctx.beginPath(); ctx.arc(b.x-1,b.y-1,size*0.4,0,Math.PI*2); ctx.fill(); ctx.globalAlpha=1;
  }
  if (b.progress<0.8) {
    ctx.globalAlpha=0.15; ctx.fillStyle=color;
    let pp=Math.max(0,b.progress-0.06);
    let px=lerp(b.sx,b.tx,pp), py=lerp(b.sy,b.ty,pp)-(Math.abs(b.sy-b.ty)+130)*4*pp*(1-pp);
    ctx.beginPath(); ctx.arc(px,py,size*0.7,0,Math.PI*2); ctx.fill(); ctx.globalAlpha=1;
  }
}

function drawSplash(s) {
  let p=1-s.life/s.maxLife, r=15+p*35;
  ctx.globalAlpha=(1-p)*0.5; ctx.fillStyle=s.color; ctx.beginPath(); ctx.arc(s.x,s.y,r,0,Math.PI*2); ctx.fill();
  ctx.strokeStyle=s.color; ctx.lineWidth=2; ctx.globalAlpha=(1-p)*0.8; ctx.beginPath(); ctx.arc(s.x,s.y,r,0,Math.PI*2); ctx.stroke();
  ctx.globalAlpha=1;
}

function drawSun(s) {
  let pulse=1+Math.sin(frameCount*0.08)*0.08, r=16*pulse;
  ctx.fillStyle='rgba(255,235,59,0.15)'; ctx.beginPath(); ctx.arc(s.x,s.y,r+10,0,Math.PI*2); ctx.fill();
  ctx.fillStyle='#ffd600';
  for(let i=0;i<8;i++){let a=(i/8)*Math.PI*2+frameCount*0.02;ctx.beginPath();ctx.ellipse(s.x+Math.cos(a)*r*0.7,s.y+Math.sin(a)*r*0.7,5,3,a,0,Math.PI*2);ctx.fill();}
  let sG=ctx.createRadialGradient(s.x-3,s.y-3,1,s.x,s.y,r);
  sG.addColorStop(0,'#fff9c4'); sG.addColorStop(0.5,'#ffd600'); sG.addColorStop(1,'#f9a825');
  ctx.fillStyle=sG; ctx.beginPath(); ctx.arc(s.x,s.y,r,0,Math.PI*2); ctx.fill();
  ctx.fillStyle='#f57f17';
  ctx.beginPath(); ctx.arc(s.x-4,s.y-2,2,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(s.x+4,s.y-2,2,0,Math.PI*2); ctx.fill();
  ctx.strokeStyle='#f57f17'; ctx.lineWidth=1.5; ctx.beginPath(); ctx.arc(s.x,s.y+3,4,0.2,Math.PI-0.2); ctx.stroke();
}

function drawLawnmower(m) {
  let y=GRID.top+m.row*GRID.h+GRID.h/2+20;
  ctx.fillStyle='#d32f2f'; ctx.fillRect(m.x-12,y-8,24,16);
  ctx.fillStyle='#b71c1c'; ctx.fillRect(m.x-10,y-6,20,12);
  ctx.fillStyle='#222';
  ctx.beginPath(); ctx.arc(m.x-10,y+8,4,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(m.x+10,y+8,4,0,Math.PI*2); ctx.fill();
  if(m.moving){let a=frameCount*0.5;ctx.strokeStyle='#aaa';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(m.x+Math.cos(a)*8,y+Math.sin(a)*4);ctx.lineTo(m.x-Math.cos(a)*8,y-Math.sin(a)*4);ctx.stroke();}
}

function drawCardSlot() {
  let pX=10,pY=10,pW=210,pH=74;
  ctx.fillStyle='rgba(20,12,5,0.88)'; ctx.strokeStyle='#5a3a1a'; ctx.lineWidth=2;
  ctx.beginPath(); ctx.roundRect(pX,pY,pW,pH,8); ctx.fill(); ctx.stroke();
  for (let i=0;i<cards.length;i++) {
    let c=cards[i], cx=pX+6+i*36, cy=pY+6, cw=34, ch=60;
    let ok=sun>=c.cost&&c.cooldown<=0, sel=selectedCard===i;
    ctx.fillStyle=sel?'#4a3520':(ok?'#3a2a18':'#1a1210');
    ctx.strokeStyle=sel?'#ffa000':'#5a3a1a'; ctx.lineWidth=sel?2:1;
    ctx.beginPath(); ctx.roundRect(cx,cy,cw,ch,4); ctx.fill(); ctx.stroke();
    if(c.cooldown>0){ctx.fillStyle='rgba(0,0,0,0.6)';ctx.fillRect(cx+1,cy+1,cw-2,(ch-2)*(c.cooldown/c.cd));}
    ctx.globalAlpha=ok?1:0.4;
    let icx=cx+cw/2, icy=cy+24;
    switch(c.type) {
      case 'catapult':
        ctx.fillStyle='#558b2f'; ctx.fillRect(icx-2,icy+4,4,10);
        drawLeaf(icx,icy+6,10,5,-0.6,'#4caf50','#2e7d32');
        drawLeaf(icx,icy+8,10,5,0.5,'#43a047','#2e7d32');
        ctx.strokeStyle='#2e7d32'; ctx.lineWidth=2; ctx.lineCap='round';
        ctx.beginPath(); ctx.moveTo(icx,icy); ctx.lineTo(icx+10,icy-8); ctx.stroke(); ctx.lineCap='butt';
        ctx.fillStyle='#8bc34a'; ctx.beginPath(); ctx.arc(icx+10,icy-9,3.5,0,Math.PI*2); ctx.fill();
        break;
      case 'wintermelon':
        ctx.fillStyle='#00695c'; ctx.fillRect(icx-2,icy+4,4,10);
        drawLeaf(icx,icy+6,10,5,-0.6,'#26a69a','#00695c');
        drawLeaf(icx,icy+8,10,5,0.5,'#2bbbad','#00695c');
        ctx.strokeStyle='#00695c'; ctx.lineWidth=2; ctx.lineCap='round';
        ctx.beginPath(); ctx.moveTo(icx,icy); ctx.lineTo(icx+10,icy-8); ctx.stroke(); ctx.lineCap='butt';
        ctx.fillStyle='#4db6ac'; ctx.beginPath(); ctx.ellipse(icx+10,icy-9,4,3.5,0.2,0,Math.PI*2); ctx.fill();
        break;
      case 'kernel':
        ctx.fillStyle='#558b2f'; ctx.fillRect(icx-2,icy+4,4,10);
        drawLeaf(icx,icy+6,10,4,-0.7,'#7cb342','#558b2f');
        drawLeaf(icx,icy+8,10,4,0.6,'#8bc34a','#689f38');
        ctx.strokeStyle='#558b2f'; ctx.lineWidth=2; ctx.lineCap='round';
        ctx.beginPath(); ctx.moveTo(icx,icy); ctx.lineTo(icx+10,icy-8); ctx.stroke(); ctx.lineCap='butt';
        ctx.fillStyle='#fff3e0'; ctx.beginPath(); ctx.arc(icx+10,icy-9,3,0,Math.PI*2); ctx.fill();
        break;
      case 'sunflower':
        ctx.fillStyle='#ffd600';
        for(let j=0;j<6;j++){let a=(j/6)*Math.PI*2;ctx.beginPath();ctx.ellipse(icx+Math.cos(a)*6,icy+Math.sin(a)*6,4,2,a,0,Math.PI*2);ctx.fill();}
        ctx.fillStyle='#5d4037'; ctx.beginPath(); ctx.arc(icx,icy,5,0,Math.PI*2); ctx.fill();
        break;
      case 'wallnut':
        ctx.fillStyle='#a0724a'; ctx.beginPath(); ctx.ellipse(icx,icy,9,11,0,0,Math.PI*2); ctx.fill();
        ctx.fillStyle='#3e2723';
        ctx.beginPath(); ctx.arc(icx-3,icy-2,1.5,0,Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.arc(icx+3,icy-2,1.5,0,Math.PI*2); ctx.fill();
        break;
    }
    ctx.globalAlpha=1;
    ctx.fillStyle=sun>=c.cost?'#ffd700':'#ff5252'; ctx.font='bold 10px Nunito'; ctx.textAlign='center';
    ctx.fillText(c.cost,cx+cw/2,cy+ch-4);
  }
  let sx=pX+6+cards.length*36+2, sy=pY+15;
  ctx.fillStyle=shovelMode?'#5a3020':'#2a1a10'; ctx.strokeStyle=shovelMode?'#ff6d00':'#5a3a1a'; ctx.lineWidth=shovelMode?2:1;
  ctx.beginPath(); ctx.roundRect(sx,sy,28,40,4); ctx.fill(); ctx.stroke();
  ctx.fillStyle='#8d6e63'; ctx.fillRect(sx+12,sy+6,4,22);
  ctx.fillStyle='#78909c'; ctx.beginPath(); ctx.moveTo(sx+6,sy+6); ctx.lineTo(sx+22,sy+6); ctx.lineTo(sx+20,sy+14); ctx.lineTo(sx+8,sy+14); ctx.closePath(); ctx.fill();
}

function drawParticles() {
  for (let p of particles) { ctx.globalAlpha=p.life/p.maxLife; ctx.fillStyle=p.color; ctx.beginPath(); ctx.arc(p.x,p.y,p.size,0,Math.PI*2); ctx.fill(); }
  ctx.globalAlpha=1;
}

function drawHoverHighlight() {
  if (selectedCard===null&&!shovelMode) return;
  let g=hoverGrid; if(!g) return;
  if (shovelMode) { ctx.strokeStyle='rgba(255,80,80,0.7)'; ctx.lineWidth=2; ctx.setLineDash([4,4]); ctx.strokeRect(GRID.left+g.col*GRID.w,GRID.top+g.row*GRID.h,GRID.w,GRID.h); ctx.setLineDash([]); }
  else { ctx.fillStyle=plantAt(g.row,g.col)?'rgba(255,0,0,0.15)':'rgba(100,255,100,0.15)'; ctx.fillRect(GRID.left+g.col*GRID.w,GRID.top+g.row*GRID.h,GRID.w,GRID.h); }
}

function getRemainingInWave() {
  if (!waveActive) return 0;
  return waveSpawnList.length - waveSpawnIndex;
}

function drawCountdown() {
  if (!waveActive && wave < totalWaves && nextWaveDelay > 300) {
    let barW = 200, barH = 8;
    let barX = W/2 - barW/2, barY = GRID.top - 16;
    let progress = 1 - (nextWaveDelay - 300) / (1500 - 300);
    ctx.fillStyle = 'rgba(0,0,0,0.4)';
    ctx.beginPath(); ctx.roundRect(barX, barY, barW, barH, 4); ctx.fill();
    let bG = ctx.createLinearGradient(barX, 0, barX + barW * progress, 0);
    bG.addColorStop(0, '#e65100');
    bG.addColorStop(1, '#ff9800');
    ctx.fillStyle = bG;
    ctx.beginPath(); ctx.roundRect(barX, barY, barW * progress, barH, 4); ctx.fill();
    ctx.fillStyle = 'rgba(255,180,100,0.7)';
    ctx.font = "14px 'Nunito', sans-serif";
    ctx.textAlign = 'center';
    let secs = Math.ceil((nextWaveDelay - 300) / 60);
    ctx.fillText('Next wave in ' + secs + 's', W/2, barY - 4);
  }

  // During active wave: show remaining count and next spawn timer
  if (waveActive && waveSpawnIndex < waveSpawnList.length) {
    let remaining = getRemainingInWave();
    let total = waveSpawnList.length;
    ctx.fillStyle = 'rgba(255,150,50,0.9)';
    ctx.font = "bold 18px 'Bangers', cursive";
    ctx.textAlign = 'center';
    ctx.fillText('Wave ' + wave + ' — ' + remaining + ' zombie' + (remaining !== 1 ? 's' : '') + ' remaining', W/2, GRID.top - 20);

    // Small timer bar for next spawn
    let barW = 120, barH = 5;
    let barX = W/2 - barW/2, barY = GRID.top - 8;
    let progress = 1 - nextSpawnTimer / 540;
    ctx.fillStyle = 'rgba(0,0,0,0.3)';
    ctx.beginPath(); ctx.roundRect(barX, barY, barW, barH, 3); ctx.fill();
    ctx.fillStyle = 'rgba(255,120,50,0.6)';
    ctx.beginPath(); ctx.roundRect(barX, barY, barW * progress, barH, 3); ctx.fill();
  }
}

function draw() {
  ctx.clearRect(0,0,W,H);
  drawBackground();
  for (let r=0;r<GRID.rows;r++) for (let c=0;c<GRID.cols;c++) if(!plantAt(r,c)){let pos=gridPos(r,c);drawPot(pos.x,pos.y+20,false);}
  for (let m of lawnMowers) if(m.active) drawLawnmower(m);
  drawHoverHighlight();
  drawCountdown();
  for (let p of plants) drawPlant(p);
  for (let s of splashes) drawSplash(s);
  for (let b of bullets) drawBullet(b);
  let sz=[...zombies].sort((a,b)=>a.row-b.row||a.x-b.x);
  for (let z of sz) drawZombie(z);
  for (let s of suns) drawSun(s);
  drawParticles();
  drawCardSlot();
  // Final warning before wave ends (last zombie)
  if (!waveActive && waveSpawnIndex >= waveSpawnList.length && waveSpawnList.length > 0 && zombies.length > 0 && wave < totalWaves) {
    // nothing — let the countdown bar show
  }
}

let mouseX=0, mouseY=0, hoverGrid=null;
canvas.addEventListener('mousemove',e=>{let r=canvas.getBoundingClientRect();mouseX=(e.clientX-r.left)*(W/r.width);mouseY=(e.clientY-r.top)*(H/r.height);hoverGrid=toGrid(mouseX,mouseY);});
canvas.addEventListener('click',e=>{
  if(state!=='playing') return;
  let r=canvas.getBoundingClientRect(), mx=(e.clientX-r.left)*(W/r.width), my=(e.clientY-r.top)*(H/r.height);
  for(let s of suns) if(!s.collecting&&dist(mx,my,s.x,s.y)<22){collectSun(s);return;}
  let pX=10,pY=10;
  for(let i=0;i<cards.length;i++){let cx=pX+6+i*36,cy=pY+6;if(mx>=cx&&mx<=cx+34&&my>=cy&&my<=cy+60){let c=cards[i];if(sun>=c.cost&&c.cooldown<=0){shovelMode=false;selectedCard=selectedCard===i?null:i;}else if(c.cooldown>0)showToast('Plant is recharging!');else showToast('Not enough sun!');return;}}
  let sx=pX+6+cards.length*36+2,sy=pY+15;
  if(mx>=sx&&mx<=sx+28&&my>=sy&&my<=sy+40){selectedCard=null;shovelMode=!shovelMode;return;}
  let g=toGrid(mx,my);
  if(g){
    if(shovelMode){let p=plantAt(g.row,g.col);if(p){plants=plants.filter(pl=>pl!==p);let pos=gridPos(g.row,g.col);spawnParticles(pos.x,pos.y,'#a0724a',6,[2,4],[1,3]);shovelMode=false;}return;}
    if(selectedCard!==null){let c=cards[selectedCard];if(plantAt(g.row,g.col)){showToast('There is already a plant here!');return;}if(sun<c.cost){showToast('Not enough sun!');return;}sun-=c.cost;plants.push({type:c.type,row:g.row,col:g.col,hp:c.hp,maxHp:c.hp,timer:0,animT:rand(0,10),firing:0});c.cooldown=c.cd;selectedCard=null;updateHUD();}
  }else{selectedCard=null;shovelMode=false;}
});
canvas.addEventListener('contextmenu',e=>{e.preventDefault();selectedCard=null;shovelMode=false;});

function updateHUD(){document.getElementById('sunTxt').textContent=sun;document.getElementById('waveTxt').textContent='Wave '+wave+'/'+totalWaves;}
function showOverlay(title,sub,desc){const ol=document.getElementById('overlay');ol.classList.remove('hidden');ol.innerHTML=`<h1>${title}</h1><h2>${sub}</h2><p>${desc}</p><button class="btn" id="restartBtn">PLAY AGAIN</button>`;document.getElementById('restartBtn').addEventListener('click',()=>{ol.classList.add('hidden');initGame();state='playing';updateHUD();});}

document.getElementById('startBtn').addEventListener('click',()=>{document.getElementById('overlay').classList.add('hidden');initGame();state='playing';updateHUD();});

function gameLoop(){update();draw();requestAnimationFrame(gameLoop);}
if(!ctx.roundRect){CanvasRenderingContext2D.prototype.roundRect=function(x,y,w,h,r){if(typeof r==='number')r=[r,r,r,r];this.moveTo(x+r[0],y);this.lineTo(x+w-r[1],y);this.quadraticCurveTo(x+w,y,x+w,y+r[1]);this.lineTo(x+w,y+h-r[2]);this.quadraticCurveTo(x+w,y+h,x+w-r[2],y+h);this.lineTo(x+r[3],y+h);this.quadraticCurveTo(x,y+h,x,y+h-r[3]);this.lineTo(x,y+r[0]);this.quadraticCurveTo(x,y,x+r[0],y);this.closePath();};}
gameLoop();
</script>
