<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PvZ Roof Levels</title>
<link href="https://fonts.googleapis.com/css2?family=Bangers&family=Nunito:wght@400;700;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0a0806;display:flex;justify-content:center;align-items:center;min-height:100vh;overflow:hidden;font-family:'Nunito',sans-serif}
#wrap{position:relative;width:960px;height:640px}
canvas{display:block;border-radius:8px;box-shadow:0 0 80px rgba(255,120,30,0.12),0 0 160px rgba(255,80,0,0.06)}
#hud{position:absolute;top:8px;left:8px;right:8px;display:flex;align-items:center;gap:10px;pointer-events:none;z-index:10}
.sun-box{background:linear-gradient(135deg,#2a1800,#1a0f00);border:2px solid #d4920a;border-radius:10px;padding:4px 14px;display:flex;align-items:center;gap:6px;color:#ffd700;font-family:'Bangers',cursive;font-size:26px;letter-spacing:1px;pointer-events:auto;min-width:80px}
.sun-box span{color:#fff;font-size:18px}
.wave-box{margin-left:auto;background:linear-gradient(135deg,#1a0a00,#2a1500);border:2px solid #c44;border-radius:10px;padding:4px 16px;color:#ff8866;font-family:'Bangers',cursive;font-size:20px;letter-spacing:1px}
#overlay{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(5,3,0,0.88);z-index:20;border-radius:8px;transition:opacity 0.4s}
#overlay.hidden{opacity:0;pointer-events:none}
#overlay h1{font-family:'Bangers',cursive;font-size:56px;color:#ffd700;text-shadow:0 4px 20px rgba(255,180,0,0.4),0 0 60px rgba(255,120,0,0.2);letter-spacing:3px;margin-bottom:4px}
#overlay h2{font-family:'Bangers',cursive;font-size:28px;color:#ff9944;margin-bottom:24px;font-weight:400}
#overlay p{color:#ccaa88;font-size:15px;margin-bottom:20px;text-align:center;max-width:460px;line-height:1.6}
.btn{font-family:'Bangers',cursive;font-size:26px;letter-spacing:2px;padding:12px 44px;border:none;border-radius:12px;cursor:pointer;transition:all 0.2s;color:#fff;background:linear-gradient(135deg,#e67e22,#d35400);box-shadow:0 4px 20px rgba(230,126,34,0.4)}
.btn:hover{transform:translateY(-2px) scale(1.03);box-shadow:0 6px 30px rgba(230,126,34,0.6)}
.btn:active{transform:scale(0.97)}
.toast{position:absolute;top:60px;left:50%;transform:translateX(-50%);background:rgba(180,40,20,0.92);color:#fff;padding:8px 20px;border-radius:8px;font-size:14px;font-weight:700;z-index:15;pointer-events:none;opacity:0;transition:opacity 0.3s}
.toast.show{opacity:1}
</style>
</head>
<body>
<div id="wrap">
<canvas id="c" width="960" height="640"></canvas>
<div id="hud">
  <div class="sun-box"><span>☀</span><span id="sunTxt">150</span></div>
  <div class="wave-box" id="waveTxt">Wave 0/5</div>
</div>
<div id="overlay">
  <h1>ROOF DEFENSE</h1>
  <h2>Plants vs Zombies — Night Roof</h2>
  <p>The zombies are climbing the roof! Your catapult plants lob projectiles from their leafy arms. Collect sun to grow your defenses.</p>
  <button class="btn" id="startBtn">START GAME</button>
</div>
<div class="toast" id="toast"></div>
</div>

<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
const W = 960, H = 640;
const GRID = { rows: 5, cols: 9, left: 215, top: 95, w: 78, h: 98 };

let state = 'menu', sun = 150, wave = 0, totalWaves = 5;
let nextSpawnTimer = 0, waveActive = false;
let nextWaveDelay = 1200, frameCount = 0;
let selectedCard = null, shovelMode = false;
let plants = [], zombies = [], bullets = [], suns = [], particles = [], splashes = [], lawnMowers = [];

// Wave spawning: flat list of zombie types, spawned one at a time
let waveSpawnList = [];
let waveSpawnIndex = 0;

const PLANT_DEFS = {
  catapult:   { cost:100, hp:300,  cd:420,  color:'#4caf50', name:'Cabbage-pult' },
  sunflower:  { cost:50,  hp:300,  cd:420,  color:'#ffd700', name:'Sunflower' },
  wallnut:    { cost:50,  hp:2000, cd:1200, color:'#a0522d', name:'Wall-nut' },
  wintermelon:{ cost:200, hp:300,  cd:420,  color:'#26a69a', name:'Winter Melon' },
  kernel:     { cost:100, hp:300,  cd:420,  color:'#ffb74d', name:'Kernel-pult' }
};
const PLANT_ORDER = ['sunflower','catapult','wallnut','wintermelon','kernel'];

const ZOMBIE_DEFS = {
  normal:  { hp:200,  speed:0.28 },
  cone:    { hp:560,  speed:0.28 },
  bucket:  { hp:1100, speed:0.25 },
  flag:    { hp:200,  speed:0.42 }
};

const WAVE_DATA = [
  [{t:'normal',n:3}],
  [{t:'normal',n:4},{t:'cone',n:2}],
  [{t:'normal',n:5},{t:'cone',n:3},{t:'flag',n:1}],
  [{t:'normal',n:4},{t:'cone',n:4},{t:'bucket',n:2}],
  [{t:'normal',n:6},{t:'cone',n:5},{t:'bucket',n:4},{t:'flag',n:2}]
];

let cards = PLANT_ORDER.map((type, i) => ({
  type, ...PLANT_DEFS[type], cooldown: 0, index: i
}));

function gridPos(row, col) {
  return { x: GRID.left + col * GRID.w + GRID.w / 2, y: GRID.top + row * GRID.h + GRID.h / 2 + 8 };
}
function toGrid(mx, my) {
  let col = Math.floor((mx - GRID.left) / GRID.w);
  let row = Math.floor((my - GRID.top) / GRID.h);
  if (row < 0 || row >= GRID.rows || col < 0 || col >= GRID.cols) return null;
  return { row, col };
}
function plantAt(row, col) { return plants.find(p => p.row === row && p.col === col); }
function rand(a, b) { return a + Math.random() * (b - a); }
function randInt(a, b) { return Math.floor(rand(a, b + 1)); }
function lerp(a, b, t) { return a + (b - a) * t; }
function dist(x1, y1, x2, y2) { return Math.hypot(x2 - x1, y2 - y1); }

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 1800);
}

function spawnParticles(x, y, color, count, sr, vr) {
  for (let i = 0; i < count; i++) {
    let a = rand(0, Math.PI * 2), s = rand(vr[0], vr[1]);
    particles.push({ x, y, vx: Math.cos(a)*s, vy: Math.sin(a)*s - rand(0.5,1.5), life: rand(20,50), maxLife: 50, color, size: rand(sr[0],sr[1]) });
  }
}
function spawnSplash(x, y, color) {
  splashes.push({ x, y, color, life: 25, maxLife: 25 });
  spawnParticles(x, y, color, 8, [2,5], [1.5,4]);
}

function initGame() {
  sun=150; wave=0; waveSpawnList=[]; waveSpawnIndex=0;
  waveActive=false; nextSpawnTimer=0;
  nextWaveDelay=1200; frameCount=0; selectedCard=null; shovelMode=false;
  plants=[]; zombies=[]; bullets=[]; suns=[]; particles=[]; splashes=[]; lawnMowers=[];
  for (let r=0; r<GRID.rows; r++) lawnMowers.push({row:r, x:GRID.left-35, active:true, moving:false});
  cards = PLANT_ORDER.map((type,i)=>({type,...PLANT_DEFS[type], cooldown:0, index:i}));
}

function startNextWave() {
  if (wave >= totalWaves) return;
  waveSpawnList = [];
  let data = WAVE_DATA[wave];
  for (let g of data) for (let i = 0; i < g.n; i++) waveSpawnList.push(g.t);
  // Shuffle so types are mixed up
  for (let i = waveSpawnList.length - 1; i > 0; i--) {
    let j = randInt(0, i);
    [waveSpawnList[i], waveSpawnList[j]] = [waveSpawnList[j], waveSpawnList[i]];
  }
  waveSpawnIndex = 0;
  // First zombie spawns after a short initial delay
  nextSpawnTimer = 120;
  waveActive = true;
  wave++;
  updateHUD();
}

function spawnZombie(type) {
  let d = ZOMBIE_DEFS[type];
  zombies.push({type, row:randInt(0,GRID.rows-1), x:W+rand(10,80), hp:d.hp, maxHp:d.hp, speed:d.speed, eating:false, animT:rand(0,100), slowTimer:0, buttered:false, butterTimer:0});
}

function findTargetRow(plantRow) {
  let best = null;
  for (let z of zombies) if (z.row===plantRow && z.x>GRID.left && (!best || z.x<best.x)) best=z;
  return best;
}

function spawnSkySun() {
  let x=rand(GRID.left+40, GRID.left+GRID.cols*GRID.w-40), ty=rand(GRID.top+40, GRID.top+GRID.rows*GRID.h-20);
  suns.push({x, y:-20, tx:x, ty, val:25, timer:0, falling:true, collecting:false});
}
function spawnPlantSun(px,py) {
  suns.push({x:px, y:py-10, tx:px+rand(-30,30), ty:py+rand(20,50), val:25, timer:0, falling:true, collecting:false});
}
function collectSun(s) { s.collecting=true; s.tx=70; s.ty=30; }

function update() {
  if (state !== 'playing') return;
  frameCount++;
  if (frameCount % 540 === 0) spawnSkySun();

  // One-at-a-time wave spawning
  if (waveActive && waveSpawnIndex < waveSpawnList.length) {
    nextSpawnTimer--;
    if (nextSpawnTimer <= 0) {
      spawnZombie(waveSpawnList[waveSpawnIndex]);
      waveSpawnIndex++;
      if (waveSpawnIndex < waveSpawnList.length) {
        // Set timer for next zombie: 5-9 seconds apart
        nextSpawnTimer = randInt(300, 540);
      } else {
        // Last zombie spawned, wave will end when all are dead
        waveActive = false;
      }
    }
  }

  // Between waves
  if (!waveActive && waveSpawnIndex >= waveSpawnList.length && wave < totalWaves) {
    nextWaveDelay--;
    if (nextWaveDelay <= 0) { startNextWave(); nextWaveDelay = 1500; }
  }

  if (wave>=totalWaves && !waveActive && waveSpawnIndex>=waveSpawnList.length && zombies.length===0 && bullets.length===0) {
    state='won'; showOverlay('VICTORY','The roof is secure!','You survived all 5 waves of rooftop zombies.'); return;
  }

  for (let p of plants) {
    p.animT += 0.05; p.timer++;
    if (p.type==='sunflower' && p.timer>=1440) { p.timer=0; let pos=gridPos(p.row,p.col); spawnPlantSun(pos.x,pos.y); }

    if ((p.type==='catapult'||p.type==='wintermelon') && p.timer>=90) {
      let target = findTargetRow(p.row);
      if (target) {
        p.timer=0; p.firing=14;
        let pos=gridPos(p.row,p.col);
        let isIce=p.type==='wintermelon';
        bullets.push({sx:pos.x+18, sy:pos.y-28, tx:target.x, ty:GRID.top+p.row*GRID.h+GRID.h/2+8,
          x:pos.x+18, y:pos.y-28, row:p.row, progress:0, speed:0.028,
          dmg:isIce?80:40, type:isIce?'melon':'cabbage',
          splashRadius:isIce?55:0, slowDuration:isIce?300:0, landed:false, targetX:target.x});
      }
    }

    if (p.type==='kernel' && p.timer>=110) {
      let target = findTargetRow(p.row);
      if (target) {
        p.timer=0; p.firing=14;
        let pos=gridPos(p.row,p.col);
        let isButter = Math.random()<0.3;
        bullets.push({sx:pos.x+18, sy:pos.y-28, tx:target.x, ty:GRID.top+p.row*GRID.h+GRID.h/2+8,
          x:pos.x+18, y:pos.y-28, row:p.row, progress:0, speed:0.025,
          dmg:isButter?20:30, type:isButter?'butter':'corn',
          splashRadius:0, slowDuration:0, landed:false, targetX:target.x, butter:isButter});
      }
    }
    if (p.firing>0) p.firing--;
  }

  plants = plants.filter(p => {
    if (p.hp<=0) { let pos=gridPos(p.row,p.col); spawnParticles(pos.x,pos.y,'#8b5e3c',10,[2,5],[1,3]); return false; }
    return true;
  });

  for (let b of bullets) {
    if (!b.landed) {
      b.progress += b.speed;
      if (b.progress>=1) {
        b.progress=1; b.landed=true; b.x=b.tx; b.y=b.ty;
        let sc = b.type==='melon'?'#80cbc4':b.type==='butter'?'#ffd54f':b.type==='corn'?'#ffb74d':'#8bc34a';
        spawnSplash(b.x, b.y, sc);
        for (let z of zombies) {
          if (z.row===b.row && Math.abs(z.x-b.targetX)<25) {
            z.hp-=b.dmg;
            if (b.slowDuration>0) z.slowTimer=Math.max(z.slowTimer,b.slowDuration);
            if (b.butter) { z.buttered=true; z.butterTimer=300; }
            break;
          }
        }
        if (b.splashRadius>0) {
          for (let z of zombies) {
            if (z.row===b.row && Math.abs(z.x-b.targetX)<b.splashRadius && Math.abs(z.x-b.targetX)>=25) {
              z.hp-=b.dmg*0.5; z.slowTimer=Math.max(z.slowTimer,b.slowDuration);
            }
          }
        }
      } else {
        b.x=lerp(b.sx,b.tx,b.progress);
        b.y=lerp(b.sy,b.ty,b.progress)-(Math.abs(b.sy-b.ty)+130)*4*b.progress*(1-b.progress);
      }
    }
  }
  bullets = bullets.filter(b=>!b.landed);

  for (let z of zombies) {
    z.animT+=0.06;
    if (z.slowTimer>0) z.slowTimer--;
    if (z.butterTimer>0) { z.butterTimer--; if (z.butterTimer<=0) z.buttered=false; }
    let spd=z.speed;
    if (z.buttered) spd=0; else if (z.slowTimer>0) spd*=0.45;
    z.eating=false;
    let gp=toGrid(z.x, GRID.top+z.row*GRID.h+GRID.h/2);
    if (gp) { let pl=plantAt(gp.row,gp.col); if (pl) { z.eating=true; if (frameCount%30===0) pl.hp-=100; } }
    if (!z.eating) z.x-=spd;
    if (z.x<GRID.left-10) {
      let m=lawnMowers.find(m=>m.row===z.row&&m.active&&!m.moving);
      if (m) { m.moving=true; showToast('Lawnmower activated!'); }
      else { state='lost'; showOverlay('THE ZOMBIES ATE YOUR BRAINS','The roof has fallen...','Try more Wall-nuts and catapults.'); return; }
    }
  }

  for (let m of lawnMowers) {
    if (m.moving) { m.x+=6; for (let z of zombies) if (z.row===m.row&&Math.abs(z.x-m.x)<30) { z.hp=0; spawnParticles(z.x,GRID.top+z.row*GRID.h+GRID.h/2,'#888',10,[2,5],[1,4]); } }
  }
  lawnMowers = lawnMowers.filter(m=>!m.moving||m.x<W+50);

  zombies = zombies.filter(z => { if (z.hp<=0) { spawnParticles(z.x,GRID.top+z.row*GRID.h+GRID.h/2,'#7a6a5a',12,[2,6],[1,4]); return false; } return true; });

  for (let s of suns) {
    if (s.collecting) { s.x=lerp(s.x,s.tx,0.12); s.y=lerp(s.y,s.ty,0.12); if (dist(s.x,s.y,s.tx,s.ty)<10) s.timer=9999; }
    else if (s.falling) { s.y+=0.6; if (s.y>=s.ty) { s.y=s.ty; s.falling=false; } }
    else s.timer++;
  }
  suns = suns.filter(s => { if (s.collecting&&s.timer>=9999) { sun+=s.val; updateHUD(); return false; } return s.timer<600; });

  for (let p of particles) { p.x+=p.vx; p.y+=p.vy; p.vy+=0.08; p.life--; }
  particles = particles.filter(p=>p.life>0);
  for (let s of splashes) s.life--;
  splashes = splashes.filter(s=>s.life>0);
  for (let c of cards) if (c.cooldown>0) c.cooldown--;
}

function drawBackground() {
  let grad = ctx.createLinearGradient(0,0,0,H);
  grad.addColorStop(0,'#0b0e1a'); grad.addColorStop(0.15,'#151a30');
  grad.addColorStop(0.3,'#1a1832'); grad.addColorStop(1,'#0d0a08');
  ctx.fillStyle=grad; ctx.fillRect(0,0,W,H);

  ctx.fillStyle='rgba(255,255,220,0.6)';
  for (let i=0;i<40;i++) {
    let sx=(i*137.5+50)%W, sy=(i*73.7+10)%(GRID.top-20), ss=0.5+(i%3)*0.5;
    ctx.globalAlpha=(0.5+0.5*Math.sin(frameCount*0.02+i))*0.7;
    ctx.beginPath(); ctx.arc(sx,sy,ss,0,Math.PI*2); ctx.fill();
  }
  ctx.globalAlpha=1;

  ctx.fillStyle='#ffe8b0'; ctx.shadowColor='#ffe8b0'; ctx.shadowBlur=40;
  ctx.beginPath(); ctx.arc(W-100,45,28,0,Math.PI*2); ctx.fill();
  ctx.fillStyle='#0b0e1a'; ctx.beginPath(); ctx.arc(W-88,38,24,0,Math.PI*2); ctx.fill();
  ctx.shadowBlur=0;

  let rT=GRID.top-5, rB=GRID.top+GRID.rows*GRID.h+10;
  let rG=ctx.createLinearGradient(0,rT,0,rB);
  rG.addColorStop(0,'#6b3a1f'); rG.addColorStop(0.3,'#7a4225');
  rG.addColorStop(0.7,'#6d3820'); rG.addColorStop(1,'#5a2e18');
  ctx.fillStyle=rG; ctx.fillRect(0,rT,W,rB-rT);

  ctx.strokeStyle='rgba(0,0,0,0.12)'; ctx.lineWidth=1;
  for (let r=0;r<=GRID.rows;r++) { let y=GRID.top+r*GRID.h; ctx.beginPath(); ctx.moveTo(GRID.left-30,y); ctx.lineTo(GRID.left+GRID.cols*GRID.w+15,y); ctx.stroke(); }
  for (let c=0;c<=GRID.cols;c++) { let x=GRID.left+c*GRID.w; ctx.beginPath(); ctx.moveTo(x,rT); ctx.lineTo(x,rB); ctx.stroke(); }

  ctx.globalAlpha=0.035;
  for (let i=0;i<200;i++) { ctx.fillStyle=i%2?'#fff':'#000'; ctx.fillRect(GRID.left+(i*47.3)%(GRID.cols*GRID.w),GRID.top+(i*31.7)%(GRID.rows*GRID.h),rand(2,6),rand(2,6)); }
  ctx.globalAlpha=1;

  ctx.fillStyle='#4a2512'; ctx.fillRect(0,rB,W,8);
  ctx.fillStyle='#3a1c0d'; ctx.fillRect(0,rB+8,W,4);

  let wG=ctx.createLinearGradient(0,0,GRID.left-30,0);
  wG.addColorStop(0,'#1a120e'); wG.addColorStop(1,'#2a1a12');
  ctx.fillStyle=wG; ctx.fillRect(0,rT,GRID.left-30,rB-rT+12);

  let rr=ctx.createLinearGradient(GRID.left+GRID.cols*GRID.w+15,0,W,0);
  rr.addColorStop(0,'#6b3a1f'); rr.addColorStop(1,'#1a120e');
  ctx.fillStyle=rr; ctx.fillRect(GRID.left+GRID.cols*GRID.w+15,rT,W-GRID.left-GRID.cols*GRID.w-15,rB-rT+12);

  ctx.fillStyle='#5a2e18'; ctx.fillRect(W-160,0,40,rT+5);
  ctx.fillStyle='#4a2512'; ctx.fillRect(W-165,0,50,12);
  ctx.globalAlpha=0.08;
  for (let i=0;i<5;i++) {
    let sy=rT-20-i*18-Math.sin(frameCount*0.01+i)*8, sx=W-140+Math.sin(frameCount*0.015+i*2)*12;
    ctx.fillStyle='#aaa'; ctx.beginPath(); ctx.arc(sx,sy,8+i*3,0,Math.PI*2); ctx.fill();
  }
  ctx.globalAlpha=1;
}

function drawPot(cx,cy,hl) {
  let tw=34,bw=24,h=32,rim=6;
  ctx.fillStyle='rgba(0,0,0,0.25)';
  ctx.beginPath(); ctx.ellipse(cx+2,cy+h/2+3,bw/2+4,6,0,0,Math.PI*2); ctx.fill();
  let pG=ctx.createLinearGradient(cx-tw/2,0,cx+tw/2,0);
  pG.addColorStop(0,'#8b5e3c'); pG.addColorStop(0.3,'#c4844a');
  pG.addColorStop(0.6,'#d49660'); pG.addColorStop(1,'#8b5e3c');
  ctx.fillStyle=pG;
  ctx.beginPath(); ctx.moveTo(cx-tw/2,cy-h/2+rim); ctx.lineTo(cx-bw/2,cy+h/2);
  ctx.lineTo(cx+bw/2,cy+h/2); ctx.lineTo(cx+tw/2,cy-h/2+rim); ctx.closePath(); ctx.fill();
  let rG=ctx.createLinearGradient(cx-tw/2-2,0,cx+tw/2+2,0);
  rG.addColorStop(0,'#9a6a42'); rG.addColorStop(0.35,'#d4a070');
  rG.addColorStop(0.65,'#dbb080'); rG.addColorStop(1,'#9a6a42');
  ctx.fillStyle=rG;
  ctx.beginPath(); ctx.moveTo(cx-tw/2-2,cy-h/2); ctx.lineTo(cx+tw/2+2,cy-h/2);
  ctx.lineTo(cx+tw/2,cy-h/2+rim); ctx.lineTo(cx-tw/2,cy-h/2+rim); ctx.closePath(); ctx.fill();
  ctx.strokeStyle='rgba(255,220,180,0.3)'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(cx-tw/2,cy-h/2+1); ctx.lineTo(cx+tw/2,cy-h/2+1); ctx.stroke();
  ctx.fillStyle='#3e2723'; ctx.beginPath(); ctx.ellipse(cx,cy-h/2+rim+2,tw/2-3,5,0,0,Math.PI*2); ctx.fill();
  ctx.fillStyle='#4e342e'; ctx.beginPath(); ctx.ellipse(cx,cy-h/2+rim+1,tw/2-4,3,0,0,Math.PI*2); ctx.fill();
  if (hl) { ctx.strokeStyle='rgba(255,255,100,0.7)'; ctx.lineWidth=2; ctx.beginPath(); ctx.ellipse(cx,cy+2,tw/2+3,h/2+5,0,0,Math.PI*2); ctx.stroke(); }
}

function drawLeaf(x, y, len, width, angle, color, darkColor) {
  ctx.save(); ctx.translate(x, y); ctx.rotate(angle);
  let lG = ctx.createLinearGradient(0,-width/2,0,width/2);
  lG.addColorStop(0, darkColor || '#2e7d32');
  lG.addColorStop(0.4, color);
  lG.addColorStop(1, darkColor || '#1b5e20');
  ctx.fillStyle = lG;
  ctx.beginPath(); ctx.moveTo(0, 0);
