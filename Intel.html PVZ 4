function drawSunflower(x, y, t) {
  let bob = Math.sin(t) * 2;
  ctx.fillStyle = '#33691e'; ctx.fillRect(x-3, y-2+bob, 6, 20);
  ctx.fillStyle = '#558b2f';
  ctx.beginPath(); ctx.ellipse(x-10, y+10, 9, 4, -0.5, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(x+10, y+12, 9, 4, 0.5, 0, Math.PI*2); ctx.fill();
  for (let i=0;i<10;i++) {
    let a=(i/10)*Math.PI*2+Math.sin(t*0.5)*0.1;
    ctx.fillStyle=i%2===0?'#ffd600':'#ffab00';
    ctx.beginPath(); ctx.ellipse(x+Math.cos(a)*14, y-14+bob+Math.sin(a)*14, 7, 4, a, 0, Math.PI*2); ctx.fill();
  }
  ctx.fillStyle='#5d4037'; ctx.beginPath(); ctx.arc(x, y-14+bob, 9, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle='#6d4c41'; ctx.beginPath(); ctx.arc(x-1, y-15+bob, 7, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle='#111';
  ctx.beginPath(); ctx.arc(x-3, y-16+bob, 1.5, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(x+3, y-16+bob, 1.5, 0, Math.PI*2); ctx.fill();
  ctx.strokeStyle='#111'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.arc(x, y-12+bob, 3, 0.1, Math.PI-0.1); ctx.stroke();
}

function drawWallnut(x, y, t, hpR) {
  let sq = 1+(1-hpR)*0.15;
  ctx.fillStyle='rgba(0,0,0,0.2)'; ctx.beginPath(); ctx.ellipse(x+2,y+14,18,5,0,0,Math.PI*2); ctx.fill();
  let nG=ctx.createRadialGradient(x-5,y-10,2,x,y,20);
  nG.addColorStop(0,'#d4a060'); nG.addColorStop(0.6,'#a0724a'); nG.addColorStop(1,'#6d4c30');
  ctx.fillStyle=nG; ctx.beginPath(); ctx.ellipse(x,y-4,18*sq,22/sq,0,0,Math.PI*2); ctx.fill();
  if (hpR<0.66) { ctx.strokeStyle='#3e2723'; ctx.lineWidth=1.5; ctx.beginPath(); ctx.moveTo(x-5,y-18); ctx.lineTo(x-2,y-8); ctx.lineTo(x-8,y+2); ctx.stroke(); }
  if (hpR<0.33) { ctx.beginPath(); ctx.moveTo(x+6,y-15); ctx.lineTo(x+3,y-4); ctx.lineTo(x+9,y+8); ctx.stroke(); ctx.beginPath(); ctx.moveTo(x-2,y+5); ctx.lineTo(x+4,y+14); ctx.stroke(); }
  ctx.fillStyle='#3e2723';
  ctx.beginPath(); ctx.arc(x-5,y-8,2.5,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(x+5,y-8,2.5,0,Math.PI*2); ctx.fill();
  ctx.strokeStyle='#3e2723'; ctx.lineWidth=1.5;
  ctx.beginPath(); if(hpR>0.5)ctx.arc(x,y-2,4,0.2,Math.PI-0.2); else ctx.arc(x,y+4,4,Math.PI+0.3,-0.3); ctx.stroke();
  ctx.fillStyle='rgba(255,220,180,0.15)'; ctx.beginPath(); ctx.ellipse(x-6,y-14,6,8,-0.3,0,Math.PI*2); ctx.fill();
}

function drawPlant(p) {
  let pos = gridPos(p.row, p.col), x=pos.x, y=pos.y;
  drawPot(x, y+20, false);
  let hpR = p.hp / p.maxHp;
  if (hpR<1) { ctx.fillStyle='rgba(0,0,0,0.5)'; ctx.fillRect(x-16,y-44,32,4); ctx.fillStyle=hpR>0.5?'#4caf50':hpR>0.25?'#ff9800':'#f44336'; ctx.fillRect(x-16,y-44,32*hpR,4); }
  switch(p.type) {
    case 'catapult': drawCabbageCatapult(x,y,p.animT); break;
    case 'wintermelon': drawWinterMelon(x,y,p.animT); break;
    case 'kernel': drawKernelPult(x,y,p.animT); break;
    case 'sunflower': drawSunflower(x,y,p.animT); break;
    case 'wallnut': drawWallnut(x,y,p.animT,hpR); break;
  }
}

