}

/* ============================================
   MINE EXPLOSION LOGIC
   ============================================ */
const MINE_ARM_TIME = 180; // 3 seconds at 60fps
const MINE_DAMAGE = 400;

function triggerMineExplosion(plant){
  const bx = plant.x + CW2/2;
  const by = plant.y + CH2/2;

  sfxMineBoom();

  // Visual explosion effect
  mineExplosions.push({ x: bx, y: by, timer: 25, maxTimer: 25 });

  // Lots of particles — dirt, fire, debris
  addParticle(bx, by, '#8b6332', 15, 5, 7, 35, 'square');
  addParticle(bx, by, '#ff6b35', 20, 6, 6, 30, 'circle');
  addParticle(bx, by, '#ffd700', 12, 4, 5, 25, 'circle');
  addParticle(bx, by, '#5d3a1a', 10, 3, 8, 32, 'square');
  addParticle(bx, by, '#ff3d00', 8, 7, 4, 20, 'circle');

  // Damage all zombies in about a 1-cell radius
  for(const z of zombies){
    if(z.dead) continue;
    const zx = z.x + 18;
    const zy = GY + z.row * CH2 + CH2/2;
    const dx = zx - bx;
    const dy = zy - by;
    if(Math.abs(dx) < CW2 * 0.95 && Math.abs(dy) < CH2 * 0.95){
      z.hp -= MINE_DAMAGE;
    }
  }
}

/* ============================================
   UPDATE LOGIC
   ============================================ */
function update(){
  frame++;
  for(let i=0;i<cooldowns.length;i++){if(cooldowns[i]>0)cooldowns[i]--}

  if(frame%500===0){suns.push({x:GX+Math.random()*(COLS*CW2-40)+20,y:-20,vy:0.5+Math.random()*0.3,life:420,value:25})}

  for(let i=suns.length-1;i>=0;i--){const s=suns[i];s.y+=s.vy;s.life--;if(s.life<=0)suns.splice(i,1)}

  // Update plants
  let plantRemoved = false;
  for(let i=plants.length-1;i>=0;i--){
    const p=plants[i];
    if(plantRemoved){plantRemoved=false;break} // restart loop after splice
    if(p.scale<1)p.scale=Math.min(1,p.scale+0.08);

    if(p.type==='sun'){
      p.timer--;if(p.timer<=0){p.timer=1300+Math.random()*200;suns.push({x:p.x+CW2/2+(Math.random()-0.5)*20,y:p.y+10,vy:-0.8,life:360,value:25})}
    }else if(p.type==='pea'||p.type==='snow'){
      const hz=zombies.some(z=>z.row===p.row&&z.x>p.x&&!z.dead);
      if(hz){p.timer--;if(p.timer<=0){p.timer=85;projs.push({x:p.x+CW2-5,row:p.row,speed:4.5,damage:20,type:p.type==='snow'?'snow':'pea',delay:0})}}
    }else if(p.type==='repeat'){
      const hz=zombies.some(z=>z.row===p.row&&z.x>p.x&&!z.dead);
      if(hz){p.timer--;if(p.timer<=0){p.timer=85;projs.push({x:p.x+CW2-5,row:p.row,speed:4.5,damage:20,type:'pea',delay:0});projs.push({x:p.x+CW2-5,row:p.row,speed:4.5,damage:20,type:'pea',delay:8})}}
    }else if(p.type==='mine'){
      if(!p.armed){
        p.armTimer--;
        p.armProgress = 1 - (p.armTimer / MINE_ARM_TIME);
        if(p.armTimer<=0){
          p.armed = true;
          p.armProgress = 1;
          sfxMineArmed();
          addParticle(p.x+CW2/2, p.y+CH2/2+10, '#8b7355', 6, 2, 4, 15, 'square');
        }
      }
      // Note: collision is checked in the zombie update loop
    }else if(p.type==='bomb'){
      p.timer--;
      if(p.timer<=0){
        sfxBoom();const bx=p.x+CW2/2,by=p.y+CH2/2;
        addParticle(bx,by,'#ff6b35',30,6,8,40,'circle');addParticle(bx,by,'#ffd700',20,5,6,35,'circle');addParticle(bx,by,'#ff3d00',15,4,10,30,'square');
        for(const z of zombies){if(z.dead)continue;const zx=z.x+18,zy=GY+z.row*CH2+CH2/2;if(Math.abs(zx-bx)<CW2*1.6&&Math.abs(zy-by)<CH2*1.6)z.hp-=300}
        plants.splice(i,1);plantRemoved=true;continue;
      }
    }

    if(!plantRemoved && p.hp<=0 && p.type!=='mine'){
      addParticle(p.x+CW2/2,p.y+CH2/2,'#4caf50',8,3,5,25,'square');
      plants.splice(i,1);plantRemoved=true;
    }
  }

  // Update projectiles
  for(let i=projs.length-1;i>=0;i--){
    const p=projs[i];
    if(p.delay>0){p.delay--;continue}
    p.x+=p.speed;if(p.x>CW+10){projs.splice(i,1);continue}
    let hit=false;
    for(const z of zombies){
      if(z.dead)continue;
      if(z.row===p.row&&z.x<p.x+8&&z.x+36>p.x-8){
        z.hp-=p.damage;if(p.type==='snow')z.slowTimer=300;
        sfxHit();addParticle(p.x,GY+p.row*CH2+CH2/2,p.type==='snow'?'#4fc3f7':'#76ff03',4,2,3,15,'circle');
        hit=true;break;
      }
    }
    if(hit)projs.splice(i,1);
  }

  // Update zombies
  for(let i=zombies.length-1;i>=0;i--){
    const z=zombies[i];
    if(z.dead){z.deathTimer=(z.deathTimer||0)+1;if(z.deathTimer>45)zombies.splice(i,1);continue}
    if(z.slowTimer>0)z.slowTimer--;
    if(z.hp<=0){z.dead=true;z.deathTimer=0;sfxDie();addParticle(z.x+18,GY+z.row*CH2+CH2/2,'#8a9a6b',10,3,5,30,'square');continue}
    if(z.eating){
      if(!z.targetPlant||z.targetPlant.hp<=0||plants.indexOf(z.targetPlant)===-1){z.eating=false;z.targetPlant=null}
      else z.targetPlant.hp-=z.dmg;
    }else{
      z.x-=z.spd*(z.slowTimer>0?0.45:1);

      // Check for armed potato mine collision (zombie walks into it)
      for(let j=plants.length-1;j>=0;j--){
        const p=plants[j];
        if(p.type==='mine'&&!p.armed)continue; // unarmed = walk over
        if(p.type==='mine'&&p.armed&&p.row===z.row){
          const zx=z.x+18;
          if(zx < p.x+CW2+8 && zx > p.x-8){
            // BOOM! Mine explodes
            triggerMineExplosion(p);
            plants.splice(j,1);
            // Don't set z.eating — the explosion handles damage
            continue;
          }
        }
        // Normal plant collision (non-mine or unarmed mine which doesn't block)
        if(p.type!=='mine' && p.row===z.row && z.x<p.x+CW2-10 && z.x+30>p.x+10){
          z.eating=true;z.targetPlant=p;break;
        }
      }

      if(z.x<GX-10){
        if(lawnMowers[z.row]){lawnMowers[z.row]=false;sfxMow();activeMowers.push({row:z.row,x:GX-50})}
        else{state='lost';document.getElementById('go').classList.remove('h');return}
      }
    }
  }

  // Update mine explosion visuals
  for(let i=mineExplosions.length-1;i>=0;i--){
    mineExplosions[i].timer--;
    if(mineExplosions[i].timer<=0)mineExplosions.splice(i,1);
  }

  // Active mowers
  for(let i=activeMowers.length-1;i>=0;i--){
    const m=activeMowers[i];m.x+=6;
    for(const z of zombies){if(!z.dead&&z.row===m.row&&Math.abs(z.x-m.x)<40)z.hp=0}
    if(m.x>CW+50)activeMowers.splice(i,1);
  }

  // Particles
  for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.x+=p.vx;p.y+=p.vy;p.vy+=0.1;p.life--;if(p.life<=0)particles.splice(i,1)}

  updateWaves();
  if(waveAnnounce){waveAnnounce.alpha-=0.008;if(waveAnnounce.alpha<=0)waveAnnounce=null}
  if(wave>=allWaves.length&&waveQueue.length===0&&zombies.filter(z=>!z.dead).length===0&&state==='play'){state='won';document.getElementById('vi').classList.remove('h')}
}

function updateWaves(){
  if(wave>=allWaves.length)return;
  waveDelay--;
  if(waveDelay<=0&&waveQueue.length===0){
    waveQueue=allWaves[wave].map(wz=>({type:wz.type,row:wz.row,delay:wz.delay,spawned:false}));
    const isLast=wave===allWaves.length-1;
    waveAnnounce={text:isLast?'FINAL WAVE!':`Wave ${wave+1}`,alpha:1.5};
    wave++;
  }
  for(const wq of waveQueue){if(!wq.spawned){wq.delay--;if(wq.delay<=0){wq.spawned=true;const d=ZDEFS[wq.type];zombies.push({id:zombieIdCounter++,type:wq.type,row:wq.row,x:CW+20+Math.random()*60,hp:d.hp,spd:d.spd,dmg:d.dmg,eating:false,targetPlant:null,slowTimer:0,dead:false,deathTimer:0})}}}
  if(waveQueue.length>0&&waveQueue.every(w=>w.spawned)){waveQueue=[];if(wave<allWaves.length)waveDelay=Math.max(400,700-wave*35)}
}

