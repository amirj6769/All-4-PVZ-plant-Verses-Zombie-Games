<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Plants vs Zombies</title>
<link href="https://fonts.googleapis.com/css2?family=Bungee&family=Nunito:wght@700;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0d1117;display:flex;justify-content:center;align-items:center;height:100vh;overflow:hidden;font-family:'Nunito',sans-serif}
canvas{display:block;max-width:100vw;max-height:100vh;border-radius:6px;box-shadow:0 0 60px rgba(0,0,0,.6)}
.ov{position:fixed;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(0,0,0,.78);z-index:10;transition:opacity .4s}
.ov.h{opacity:0;pointer-events:none}
.ov h1{font-family:'Bungee',cursive;font-size:3rem;color:#6abf4b;text-shadow:3px 3px 0 #2d6e1e,0 0 40px rgba(106,191,75,.4);margin-bottom:.3rem}
.ov h2{font-family:'Bungee',cursive;font-size:2.4rem;color:#ff6b35;text-shadow:2px 2px 0 #b8441a;margin-bottom:.8rem}
.ov p{color:#bbb;font-size:1rem;margin-bottom:.3rem;text-align:center;max-width:500px;line-height:1.5}
.ins{background:rgba(255,255,255,.06);border-radius:10px;padding:14px 22px;margin:1rem 0 1.8rem;text-align:left}
.ins p{margin-bottom:.3rem;font-size:.9rem;color:#999}
.ins span{color:#ffd700;font-weight:900}
.btn{font-family:'Bungee',cursive;font-size:1.2rem;padding:13px 38px;border:none;border-radius:10px;cursor:pointer;transition:transform .12s,box-shadow .12s;letter-spacing:1px}
.btn:hover{transform:scale(1.06)}
.btn:active{transform:scale(.96)}
.bg{background:linear-gradient(135deg,#4caf50,#2e7d32);color:#fff;box-shadow:0 4px 20px rgba(76,175,80,.35)}
.br{background:linear-gradient(135deg,#ff6b35,#c44d1a);color:#fff;box-shadow:0 4px 20px rgba(255,107,53,.35)}
</style>
</head>
<body>
<canvas id="gc" width="1100" height="625"></canvas>

<div class="ov" id="ss">
<h1>Plants vs Zombies</h1>
<p>Defend your lawn from 10 waves of undead invaders!</p>
<div class="ins">
<p><span>Click</span> seed packets to select, then click the lawn</p>
<p><span>Click</span> falling suns to collect energy</p>
<p><span>Right-click / Esc</span> to cancel, <span>Shovel</span> to remove</p>
<p><span>Potato Mine</span> arms over time, then explodes on contact</p>
<p><span>Repeater</span> fires two peas in quick succession</p>
</div>
<button class="btn bg" onclick="startGame()">Start Game</button>
</div>

<div class="ov h" id="go">
<h2>The Zombies Won!</h2>
<p>Your lawn has been overrun by the undead...</p>
<button class="btn br" onclick="startGame()">Try Again</button>
</div>

<div class="ov h" id="vi">
<h1>Victory!</h1>
<p>All 10 waves repelled! Your lawn is safe!</p>
<button class="btn bg" onclick="startGame()">Play Again</button>
</div>

<script>
const C = document.getElementById('gc');
const X = C.getContext('2d');
const CW = 1100, CH = 625;
const COLS = 9, ROWS = 5;
const GX = 110, GY = 88;
const CW2 = 88, CH2 = 100;
const EPS = 0.001;

const PDEFS = [
  { name:'Sunflower',   cost:50,  hp:100, cd:420, type:'sun' },
  { name:'Peashooter',  cost:100, hp:100, cd:420, type:'pea' },
  { name:'Repeater',    cost:200, hp:100, cd:420, type:'repeat' },
  { name:'Wall-nut',    cost:50,  hp:600, cd:750, type:'wall' },
  { name:'Snow Pea',    cost:175, hp:100, cd:420, type:'snow' },
  { name:'Cherry Bomb', cost:150, hp:100, cd:300, type:'bomb' },
  { name:'Potato Mine', cost:25,  hp:100, cd:180, type:'mine' }
];

const ZDEFS = {
  basic:  { hp:120, spd:0.32, dmg:0.8 },
  cone:   { hp:240, spd:0.32, dmg:0.8 },
  bucket: { hp:480, spd:0.26, dmg:0.9 },
  flag:   { hp:120, spd:0.45, dmg:0.8 }
};

let audioCtx;
function initAudio(){if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)()}
function playTone(f,d,t='sine',v=0.12){if(!audioCtx)return;try{const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type=t;o.frequency.value=f;g.gain.value=v;g.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+d);o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+d)}catch(e){}}
function sfxPlace(){playTone(600,.1,'sine',.1);playTone(800,.08,'sine',.08)}
function sfxSun(){playTone(900,.1,'sine',.08);playTone(1200,.12,'sine',.06)}
function sfxHit(){playTone(200,.06,'square',.05)}
function sfxDie(){playTone(150,.2,'sawtooth',.07)}
function sfxBoom(){playTone(80,.4,'sawtooth',.15);playTone(60,.5,'square',.1)}
function sfxMow(){playTone(120,.6,'sawtooth',.1)}
function sfxMineArmed(){playTone(400,.08,'sine',.06);playTone(500,.06,'sine',.05)}
function sfxMineBoom(){playTone(60,.35,'sawtooth',.18);playTone(90,.25,'square',.12);playTone(40,.4,'sawtooth',.1)}

let state,sun,selPlant,shovelMode,plants,zombies,projs,suns,particles;
let lawnMowers,cooldowns,frame,wave,waveQueue,waveDelay,waveAnnounce;
let mouseX,mouseY,clouds,activeMowers,zombieIdCounter,mineExplosions;

function resetState(){
  state='play';sun=200;selPlant=-1;shovelMode=false;
  plants=[];zombies=[];projs=[];suns=[];particles=[];activeMowers=[];mineExplosions=[];
  lawnMowers=[true,true,true,true,true];
  cooldowns=new Array(PDEFS.length).fill(0);
  frame=0;wave=0;waveQueue=[];waveDelay=350;waveAnnounce='';
  mouseX=-999;mouseY=-999;zombieIdCounter=0;
  clouds=[{x:150,y:25,w:90,h:28},{x:480,y:15,w:110,h:32},{x:800,y:30,w:80,h:24},{x:340,y:42,w:70,h:20}];
}

function genWaves(){
  const all=[];
  for(let w=0;w<10;w++){
    const zs=[];
    let count,interval;
    if(w===0){count=5;interval=160}
    else if(w===1){count=8;interval=140}
    else if(w===2){count=12;interval=125}
    else if(w===3){count=15;interval=110}
    else if(w===4){count=18;interval=100}
    else if(w===5){count=22;interval=90}
    else if(w===6){count=26;interval=82}
    else if(w===7){count=30;interval=75}
    else if(w===8){count=34;interval=68}
    else{count=40;interval=60}
    for(let i=0;i<count;i++){
      let type='basic';const r=Math.random();
      if(w>=9&&r<0.30)type='bucket';
      else if(w>=7&&r<0.25)type='bucket';
      else if(w>=5&&r<0.18)type='bucket';
      else if(w>=8&&r<0.40)type='cone';
      else if(w>=3&&r<0.25)type='cone';
      else if(w>=1&&r<0.15)type='cone';
      if(w>=4&&i===0)type='flag';
      if(w>=7&&i===1)type='flag';
      zs.push({type,row:Math.floor(Math.random()*ROWS),delay:i*interval+Math.random()*70});
    }
    all.push(zs);
  }
  return all;
}
let allWaves=genWaves();

function drawRR(x,y,w,h,r){
  w=Math.max(EPS,w);h=Math.max(EPS,h);r=Math.min(r,w/2,h/2);
  X.beginPath();X.moveTo(x+r,y);X.lineTo(x+w-r,y);X.arcTo(x+w,y,x+w,y+r,r);
  X.lineTo(x+w,y+h-r);X.arcTo(x+w,y+h,x+w-r,y+h,r);X.lineTo(x+r,y+h);
  X.arcTo(x,y+h,x,y+h-r,r);X.lineTo(x,y+r);X.arcTo(x,y,x+r,y,r);X.closePath();
}

/* ============================================
   DRAW PLANTS
   ============================================ */
function drawSunflower(cx,cy,s,t){
  X.save();X.translate(cx,cy);X.scale(s,s);
  X.fillStyle='#3a8c34';X.fillRect(-3,8,6,32);
  X.fillStyle='#4caf50';
  X.beginPath();X.ellipse(-14,22,10,5,-0.4,0,Math.PI*2);X.fill();
  X.beginPath();X.ellipse(14,28,9,4,0.3,0,Math.PI*2);X.fill();
  const rot=Math.sin(t*0.03)*0.15;
  for(let i=0;i<10;i++){
    const a=(i/10)*Math.PI*2+rot;
    X.fillStyle=i%2===0?'#ffd700':'#ffec3a';
    X.beginPath();X.ellipse(Math.cos(a)*14,Math.sin(a)*14-4,10,5,a,0,Math.PI*2);X.fill();
  }
  X.beginPath();X.arc(0,-4,10,0,Math.PI*2);X.fillStyle='#8b5e34';X.fill();
  X.fillStyle='#1a1a1a';
  X.beginPath();X.arc(-3.5,-6,2,0,Math.PI*2);X.fill();
  X.beginPath();X.arc(3.5,-6,2,0,Math.PI*2);X.fill();
  X.beginPath();X.arc(0,-2,4.5,0.15,Math.PI-0.15);X.strokeStyle='#1a1a1a';X.lineWidth=1.5;X.stroke();
  X.restore();
}

function drawShooterBase(cx,cy,s,t,blue,dbl){
  X.save();X.translate(cx,cy);X.scale(s,s);
  const main=blue?'#4fc3f7':'#4caf50',dark=blue?'#0288d1':'#2e7d32',mid=blue?'#29b6f6':'#388e3c';
  X.fillStyle='#3a8c34';X.fillRect(-3,12,6,28);
  X.fillStyle='#4caf50';X.beginPath();X.ellipse(13,22,10,5,0.4,0,Math.PI*2);X.fill();
  if(dbl){X.fillStyle='#3a8c34';X.fillRect(2,12,6,28);X.fillStyle='#4caf50';X.beginPath();X.ellipse(-13,28,9,4,-0.4,0,Math.PI*2);X.fill()}
  X.beginPath();X.arc(0,-2,17,0,Math.PI*2);X.fillStyle=main;X.fill();X.strokeStyle=dark;X.lineWidth=2;X.stroke();
  if(dbl){
    X.fillStyle=mid;X.beginPath();X.ellipse(16,-5,11,7,0,0,Math.PI*2);X.fill();
    X.fillStyle=dark;X.beginPath();X.ellipse(20,-5,6,5.5,0,0,Math.PI*2);X.fill();
    X.fillStyle=blue?'#01579b':'#1b5e20';X.beginPath();X.ellipse(21,-5,3.2,3.2,0,0,Math.PI*2);X.fill();
    X.fillStyle=mid;X.beginPath();X.ellipse(16,8,11,7,0,0,Math.PI*2);X.fill();
    X.fillStyle=dark;X.beginPath();X.ellipse(20,8,6,5.5,0,0,Math.PI*2);X.fill();
    X.fillStyle=blue?'#01579b':'#1b5e20';X.beginPath();X.ellipse(21,8,3.2,3.2,0,0,Math.PI*2);X.fill();
  }else{
    X.fillStyle=mid;X.beginPath();X.ellipse(16,2,11,8,0,0,Math.PI*2);X.fill();
    X.fillStyle=dark;X.beginPath();X.ellipse(20,2,6,6,0,0,Math.PI*2);X.fill();
    X.fillStyle=blue?'#01579b':'#1b5e20';X.beginPath();X.ellipse(21,2,3.5,3.5,0,0,Math.PI*2);X.fill();
  }
  X.fillStyle='#fff';X.beginPath();X.arc(-5,-8,5.5,0,Math.PI*2);X.fill();X.beginPath();X.arc(5,-8,5.5,0,Math.PI*2);X.fill();
  X.fillStyle='#111';X.beginPath();X.arc(-3.5,-8,2.8,0,Math.PI*2);X.fill();X.beginPath();X.arc(6.5,-8,2.8,0,Math.PI*2);X.fill();
  if(blue){X.strokeStyle='#e1f5fe';X.lineWidth=1.5;for(let i=0;i<3;i++){const a=-0.8+i*0.8,dx=Math.cos(a)*22,dy=Math.sin(a)*22-2;X.beginPath();X.moveTo(dx-3,dy);X.lineTo(dx+3,dy);X.moveTo(dx,dy-3);X.lineTo(dx,dy+3);X.stroke()}}
  if(dbl&&!blue){X.fillStyle='#81c784';X.beginPath();X.moveTo(0,-18);X.lineTo(4,-14);X.lineTo(0,-10);X.lineTo(-4,-14);X.closePath();X.fill();X.strokeStyle='#2e7d32';X.lineWidth=1;X.stroke()}
  X.restore();
}
function drawPeashooter(cx,cy,s,t,blue){drawShooterBase(cx,cy,s,t,blue,false)}
function drawRepeater(cx,cy,s,t){drawShooterBase(cx,cy,s,t,false,true)}

function drawWallnut(cx,cy,s,t,hpRatio){
  X.save();X.translate(cx,cy);X.scale(s,s);
  X.beginPath();X.ellipse(0,5,20,26,0,0,Math.PI*2);X.fillStyle='#a0724a';X.fill();X.strokeStyle='#7d5635';X.lineWidth=2.5;X.stroke();
  X.beginPath();X.ellipse(-6,-6,8,12,-0.3,0,Math.PI*2);X.fillStyle='rgba(255,255,255,0.12)';X.fill();
  if(hpRatio<0.66){X.strokeStyle='#5d3a1a';X.lineWidth=1.5;X.beginPath();X.moveTo(-5,-10);X.lineTo(-8,0);X.lineTo(-3,8);X.stroke()}
  if(hpRatio<0.33){X.beginPath();X.moveTo(6,-8);X.lineTo(10,2);X.lineTo(4,14);X.stroke();X.beginPath();X.moveTo(-10,5);X.lineTo(-2,10);X.stroke()}
  X.fillStyle='#fff';X.beginPath();X.arc(-6,-2,5,0,Math.PI*2);X.fill();X.beginPath();X.arc(6,-2,5,0,Math.PI*2);X.fill();
  X.fillStyle='#111';X.beginPath();X.arc(-5,-1.5,2.5,0,Math.PI*2);X.fill();X.beginPath();X.arc(7,-1.5,2.5,0,Math.PI*2);X.fill();
  X.beginPath();if(hpRatio>0.5)X.arc(0,6,5,0.2,Math.PI-0.2);else X.arc(0,12,5,Math.PI+0.3,-0.3);
  X.strokeStyle='#3e2210';X.lineWidth=1.8;X.stroke();X.restore();
}

function drawCherryBomb(cx,cy,s,t){
  X.save();X.translate(cx,cy);X.scale(s,s);
  const pulse=1+Math.sin(t*0.15)*0.05;
  X.beginPath();X.arc(0,0,30*pulse,0,Math.PI*2);X.fillStyle='rgba(255,80,20,0.15)';X.fill();
  X.strokeStyle='#2e7d32';X.lineWidth=3;
  X.beginPath();X.moveTo(-8,-14);X.quadraticCurveTo(-2,-28,0,-22);X.stroke();
  X.beginPath();X.moveTo(8,-14);X.quadraticCurveTo(2,-30,0,-22);X.stroke();
  X.fillStyle='#ffeb3b';X.beginPath();X.arc(0,-22,3+Math.sin(t*0.3)*1.5,0,Math.PI*2);X.fill();
  X.beginPath();X.arc(-10,2,16,0,Math.PI*2);X.fillStyle='#d32f2f';X.fill();X.strokeStyle='#b71c1c';X.lineWidth=2;X.stroke();
  X.beginPath();X.arc(-14,-3,4,0,Math.PI*2);X.fillStyle='rgba(255,255,255,0.2)';X.fill();
  X.beginPath();X.arc(10,2,16,0,Math.PI*2);X.fillStyle='#e53935';X.fill();X.strokeStyle='#c62828';X.lineWidth=2;X.stroke();
  X.beginPath();X.arc(6,-3,4,0,Math.PI*2);X.fillStyle='rgba(255,255,255,0.2)';X.fill();
  X.fillStyle='#fff';X.beginPath();X.arc(-13,-1,3.5,0,Math.PI*2);X.fill();X.beginPath();X.arc(-7,-1,3.5,0,Math.PI*2);X.fill();
  X.fillStyle='#111';X.beginPath();X.arc(-12,-0.5,2,0,Math.PI*2);X.fill();X.beginPath();X.arc(-6,-0.5,2,0,Math.PI*2);X.fill();
  X.strokeStyle='#111';X.lineWidth=2;X.beginPath();X.moveTo(-16,-5);X.lineTo(-10,-3);X.stroke();X.beginPath();X.moveTo(-4,-3);X.lineTo(-10,-5);X.stroke();
  X.restore();
}

function drawPotatoMine(cx,cy,s,t,armed,armProgress){
  X.save();X.translate(cx,cy);X.scale(s,s);
  if(!armed){
    X.fillStyle='#8b7355';X.beginPath();X.ellipse(0,10,22,10,0,0,Math.PI*2);X.fill();
    X.fillStyle='#a08968';X.beginPath();X.ellipse(0,8,18,7,0,0,Math.PI*2);X.fill();
    X.strokeStyle='#4caf50';X.lineWidth=2;X.beginPath();X.moveTo(0,4);X.lineTo(0,-4);X.stroke();
    X.fillStyle='#66bb6a';X.beginPath();X.ellipse(-3,-5,4,2.5,-0.5,0,Math.PI*2);X.fill();
    X.beginPath();X.ellipse(3,-6,3.5,2,0.4,0,Math.PI*2);X.fill();
    const prog=armProgress||0;
    X.strokeStyle='#ffd700';X.lineWidth=2.5;X.lineCap='round';
    X.beginPath();X.arc(0,10,16,-Math.PI/2,-Math.PI/2+Math.PI*2*prog);X.stroke();
  }else{
    X.beginPath();X.ellipse(0,8,20,18,0,0,Math.PI*2);X.fillStyle='#a0784a';X.fill();X.strokeStyle='#7d5a35';X.lineWidth=2;X.stroke();
    X.fillStyle='#8b7355';X.beginPath();X.ellipse(0,22,22,8,0,0,Math.PI);X.fill();
    X.beginPath();X.ellipse(-6,2,6,10,-0.2,0,Math.PI*2);X.fillStyle='rgba(255,255,255,0.1)';X.fill();
    X.fillStyle='#8b6332';X.beginPath();X.arc(8,4,3,0,Math.PI*2);X.fill();X.beginPath();X.arc(-10,12,2.5,0,Math.PI*2);X.fill();X.beginPath();X.arc(4,16,2,0,Math.PI*2);X.fill();
    X.fillStyle='#fff';X.beginPath();X.arc(-6,2,5,0,Math.PI*2);X.fill();X.beginPath();X.arc(6,2,5,0,Math.PI*2);X.fill();
    X.fillStyle='#111';X.beginPath();X.arc(-5,2.5,2.8,0,Math.PI*2);X.fill();X.beginPath();X.arc(7,2.5,2.8,0,Math.PI*2);X.fill();
    X.strokeStyle='#3e2210';X.lineWidth=2.5;X.beginPath();X.moveTo(-11,-1);X.lineTo(-3,1);X.stroke();X.beginPath();X.moveTo(11,-1);X.lineTo(3,1);X.stroke();
    X.beginPath();X.arc(0,10,5,Math.PI+0.3,-0.3);X.fillStyle='#3e2723';X.fill();
    const glow=0.12+Math.sin(t*0.1)*0.06;
    X.beginPath();X.arc(0,8,24,0,Math.PI*2);X.fillStyle=`rgba(255,60,20,${glow})`;X.fill();
  }
  X.restore();
}

function drawPlant(p,t){
  const cx=p.x+CW2/2,cy=p.y+CH2/2,s=p.scale||1;
  switch(p.type){
    case'sun':drawSunflower(cx,cy,s,t);break;
    case'pea':drawPeashooter(cx,cy,s,t,false);break;
    case'repeat':drawRepeater(cx,cy,s,t);break;
    case'wall':drawWallnut(cx,cy,s,t,p.hp/PDEFS[3].hp);break;
    case'snow':drawPeashooter(cx,cy,s,t,true);break;
    case'bomb':drawCherryBomb(cx,cy,s,t);break;
    case'mine':drawPotatoMine(cx,cy,s,t,p.armed,p.armProgress);break;
  }
}

/* ============================================
   DRAW MINE EXPLOSIONS (separate visual layer)
   ============================================ */
function drawMineExplosions(){
  for(const e of mineExplosions){
    const alpha=Math.max(0,1-e.timer/e.maxTimer);
    const scale=0.5+e.timer/e.maxTimer*0.8;
    X.save();X.translate(e.x,e.y);X.scale(scale,scale);
    X.globalAlpha=alpha;
    // Fire core
    X.beginPath();X.arc(0,0,30,0,Math.PI*2);X.fillStyle='rgba(255,120,20,0.6)';X.fill();
    X.beginPath();X.arc(0,0,18,0,Math.PI*2);X.fillStyle='rgba(255,200,50,0.8)';X.fill();
    X.beginPath();X.arc(0,0,8,0,Math.PI*2);X.fillStyle='rgba(255,255,200,0.9)';X.fill();
    // Dirt ring
    X.strokeStyle='rgba(139,115,85,0.7)';X.lineWidth=6;
    X.beginPath();X.arc(0,0,35,0,Math.PI*2);X.stroke();
    X.restore();
  }
}

/* ============================================
   DRAW ZOMBIES
   ============================================ */
function drawZombie(z,t){
  X.save();
  const cx=z.x+18,cy=GY+z.row*CH2+CH2/2;
  const bob=Math.sin(t*0.08+z.id)*3,legOff=Math.sin(t*0.12+z.id)*5;
  const isSlow=z.slowTimer>0;
  const deathRot=z.dead?Math.min((z.deathTimer||0)*0.05,1.2):0;
  X.translate(cx,cy+bob);X.rotate(deathRot);
  if(z.dead)X.globalAlpha=Math.max(0,1-(z.deathTimer||0)/40);
  const skin=isSlow?'#7ecbc0':'#8a9a6b',darkSkin=isSlow?'#5aafa4':'#6b7a50';
  X.strokeStyle='#4a4a4a';X.lineWidth=4;X.lineCap='round';
  X.beginPath();X.moveTo(-4,22);X.lineTo(-6-legOff,40);X.stroke();
  X.beginPath();X.moveTo(4,22);X.lineTo(6+legOff,40);X.stroke();
  X.fillStyle='#5a4a3a';drawRR(-12,-4,24,28,4);X.fill();
  X.fillStyle='#8b0000';X.fillRect(-2,0,4,16);
  X.strokeStyle=skin;X.lineWidth=5;const armW=Math.sin(t*0.1+z.id+1)*4;
  X.beginPath();X.moveTo(-10,4);X.lineTo(-28,-2+armW);X.stroke();
  X.beginPath();X.moveTo(-10,10);X.lineTo(-26,8-armW);X.stroke();
  X.fillStyle=skin;X.beginPath();X.arc(-28,-2+armW,4,0,Math.PI*2);X.fill();X.beginPath();X.arc(-26,8-armW,4,0,Math.PI*2);X.fill();
