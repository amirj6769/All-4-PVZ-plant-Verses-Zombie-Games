C.addEventListener('mousemove',e=>{const r=C.getBoundingClientRect();mouseX=(e.clientX-r.left)*(CW/r.width);mouseY=(e.clientY-r.top)*(CH/r.height)});
C.addEventListener('contextmenu',e=>{e.preventDefault();selPlant=-1;shovelMode=false});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){selPlant=-1;shovelMode=false}});

C.addEventListener('click',e=>{
  if(state!=='play')return;initAudio();
  const r=C.getBoundingClientRect(),cx=(e.clientX-r.left)*(CW/r.width),cy=(e.clientY-r.top)*(CH/r.height);
  for(let i=suns.length-1;i>=0;i--){const s=suns[i],dx=cx-s.x,dy=cy-s.y;if(dx*dx+dy*dy<625){sun+=s.value;sfxSun();addParticle(s.x,s.y,'#ffd700',6,2,4,20,'circle');suns.splice(i,1);return}}
  const pw=52,gap=3,startX=72;
  for(let i=0;i<PDEFS.length;i++){const px=startX+i*(pw+gap);if(cx>=px&&cx<=px+pw&&cy>=5&&cy<=77){if(sun>=PDEFS[i].cost&&cooldowns[i]<=0){selPlant=i;shovelMode=false}return}}
  const sx=startX+7*(pw+gap)+5;
  if(cx>=sx&&cx<=sx+48&&cy>=10&&cy<=72){shovelMode=!shovelMode;selPlant=-1;return}
  const col=Math.floor((cx-GX)/CW2),row=Math.floor((cy-GY)/CH2);
  if(col>=0&&col<COLS&&row>=0&&row<ROWS){
    if(shovelMode){const idx=plants.findIndex(p=>p.col===col&&p.row===row);if(idx>=0){addParticle(plants[idx].x+CW2/2,plants[idx].y+CH2/2,'#8b7355',6,2,4,20,'square');plants.splice(idx,1);shovelMode=false}return}
    if(selPlant>=0){
      const def=PDEFS[selPlant];
      if(sun>=def.cost&&cooldowns[selPlant]<=0){
        if(!plants.some(p=>p.col===col&&p.row===row)){
          sun-=def.cost;cooldowns[selPlant]=def.cd;
          let timer=85;
          if(def.type==='sun')timer=600+Math.random()*300;
          else if(def.type==='bomb')timer=60;
          else if(def.type==='mine')timer=0;
          plants.push({type:def.type,col,row,x:GX+col*CW2,y:GY+row*CH2,hp:def.hp,timer,armTimer:MINE_ARM_TIME,armed:def.type!=='mine',armProgress:def.type!=='mine'?1:0,scale:0.1});
          sfxPlace();selPlant=-1;
        }
      }
    }
  }
});

/* ============================================
   DRAW & LOOP
   ============================================ */
function draw(){
  X.clearRect(0,0,CW,CH);
  drawBackground();drawLawnMowers();
  for(const m of activeMowers){const my2=GY+m.row*CH2+CH2/2;X.save();X.translate(m.x,my2);X.fillStyle='#d32f2f';drawRR(-14,-12,28,24,4);X.fill();X.fillStyle='#333';X.beginPath();X.arc(-10,14,5,0,Math.PI*2);X.fill();X.beginPath();X.arc(10,14,5,0,Math.PI*2);X.fill();X.fillStyle='#ccc';X.beginPath();X.arc(16,0,8,0,Math.PI*2);X.fill();if(frame%3===0)addParticle(m.x,my2,'#8b7355',1,2,3,12,'square');X.restore()}
  for(let r=0;r<ROWS;r++){for(const p of plants){if(p.row===r)drawPlant(p,frame)}for(const z of zombies){if(z.row===r)drawZombie(z,frame)}}
  drawMineExplosions();
  drawProjectiles();drawSuns();drawParticles();drawUI();drawCursor();
}

function loop(){if(state==='play')update();draw();requestAnimationFrame(loop)}

function startGame(){
  initAudio();
  document.getElementById('ss').classList.add('h');
  document.getElementById('go').classList.add('h');
  document.getElementById('vi').classList.add('h');
  allWaves=genWaves();resetState();
}

resetState();state='menu';loop();
</script>
